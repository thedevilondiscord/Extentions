    }
end

function ShowLocalJoinMessage()
    local payload = BuildJoinMessagePayload()
    local localId = "local_join_" .. JoinEventId

    -- Immediate local render: the joining client does not wait for Firebase.
    ServerCachedMessages[localId] = payload
    local card = CreateMessageCard(payload, false)
    card.Visible = (ActiveTab == "SERVER")
    table.insert(ServerUIElements, card)
    DisplayNewMessageNotif(payload, localId)
end

