local function RemoveBlockedUserFromLocalChat(username)
    username = tostring(username or "")
    if username == "" then return end
    local wanted = string.lower(username)

    for _, cache in ipairs({GlobalCachedMessages, ServerCachedMessages}) do
        for key, msg in pairs(cache) do
            if type(msg) == "table" and string.lower(tostring(msg.Username or "")) == wanted then
                cache[key] = nil
