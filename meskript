local function handleCommand(raw)
    local command,args=raw:match("^!(%S+)%s*(.*)$")
    if not command then return false end
    command=lower(command);args=trim(args)
    if command=="testnotif" or command=="notify" then
        local m={ClientMessageId=newId(),DisplayName=Players.LocalPlayer.DisplayName,Username=Players.LocalPlayer.Name,Text="KRONOS notification test",PfpId=currentPfp,Timestamp=os.time()};notify(m);return true
    elseif command=="joined" then
        local m={ClientMessageId=newId(),Username="AI_MoD",DisplayName="AI MoD",JoinedDisplayName=Players.LocalPlayer.DisplayName,Text=Players.LocalPlayer.DisplayName.." has Joined the Server Chat",Timestamp=os.time(),Role="BOT",PfpId=AI_MOD_PFP,IsPrivate=false,IsJoinMessage=true,JoinEventId=tostring(Players.LocalPlayer.UserId).."_"..os.time().."_"..math.random(1000,9999)};renderLocal(m);return true
    elseif command=="tag" then
        if args=="" then tagEnabled=not tagEnabled;renderLocal(createLocalSystem("Tag display "..(tagEnabled and "enabled ✓" or "disabled ✓")));return true end
        local requested=args
        local matched=nil
        for _,r in ipairs(verifiedRoles) do if lower(r)==lower(requested) then matched=r;break end end
        if not matched then renderLocal(createLocalSystem("Command failed. You are not assigned to the role '"..requested.."' in the GitHub roster."));return true end
        tagEnabled=true;highestRole=matched;renderLocal(createLocalSystem("Tag changed successfully to "..matched.." ✓"));return true
    elseif command=="role" then
        if args=="" then renderLocal(createLocalSystem("Your highest role is "..tostring(highestRole or "None")..". Available roles: "..(#verifiedRoles>0 and table.concat(verifiedRoles,", ") or "None")));return true end
        local target=findPlayer(args)
        if not target then renderLocal(createLocalSystem("Command failed. Target player not found or prefix is ambiguous."));return true end
        local roles={};if roleRoster then for _,r in ipairs(ROLE_ORDER) do if recursiveMatch(roleRoster,r,target.UserId,target.Name) then table.insert(roles,r) end end end
        renderLocal(createLocalSystem(target.DisplayName.." — Highest: "..tostring(roles[1] or "None").." | Roles: "..(#roles>0 and table.concat(roles,", ") or "None")));return true
    elseif command=="spoof" then
        if not hasPermission("Spoof") then resolvePermissionDenied("!spoof");return true end
        local protected={architect=true,overseer=true,["com-god⛓️"]=true,["com-god"]=true};local name=trim(args)
        if name=="" then renderLocal(createLocalSystem("Usage: !spoof <NewName>"));return true end
        if protected[lower(name)] then renderLocal(createLocalSystem("Command failed. Protected names cannot be spoofed."));return true end
        spoofedDisplayName=safeText(name,40);renderLocal(createLocalSystem("Spoofed display presentation changed to "..spoofedDisplayName..". Actual identity is unchanged."));return true
    elseif command=="announce" then
        if not hasPermission("Announce") then resolvePermissionDenied("!announce");return true end
        if #args==0 then renderLocal(createLocalSystem("Usage: !announce <Text>"));return true end
        if #args>900 then renderLocal(createLocalSystem("Announcement failed. Maximum length is 900 characters."));return true end
        announce(args);return true
    elseif command=="mute" then
