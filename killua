function BuildMessageContextMenu()
    for _, child in ipairs(ContextMenu:GetChildren()) do
        if child:IsA("TextButton") then child:Destroy() end
    end

    -- The menu must only be as tall as the options that actually exist.
    -- Delete/Block are conditionally added below, so a fixed 200px height
    -- creates an empty area whenever one or both options are unavailable.
    ContextMenu.Size = UDim2.new(0, 170, 0, 0)

    AddContextMenuButton("Copy Message", 1, function()
        if CurrentContextMessage and setclipboard then
            setclipboard(tostring(CurrentContextMessage.Text or ""))
        end
    end)

    AddContextMenuButton("Reply", 2, function()
        if not CurrentContextMessage then return end
        ReplyContextMessage = CurrentContextMessage
        RefreshReplyUI()
        MessageInput:CaptureFocus()
    end)

    AddContextMenuButton("Pvt Message", 3, function()
        if not CurrentContextMessage then return end
        local msg = CurrentContextMessage
        local displayName = msg.DisplayName or msg.Username or "Unknown"
        SetPersistentPrivatePrefix(displayName, msg.Username)
    end)

    -- Block is intentionally temporary and client-side only. It is never
    -- written to Firebase or local storage, so rejoining clears the block.
    if CurrentContextMessage
        and tostring(CurrentContextMessage.Username or "") ~= ""
        and tostring(CurrentContextMessage.Username or "") ~= tostring(LocalPlayer.Name or "")
        and not CurrentContextMessage.SystemMessage then

        AddContextMenuButton("Block", 4, function()
            if not CurrentContextMessage then return end
            local targetUsername = tostring(CurrentContextMessage.Username or "")
            local targetDisplayName = tostring(CurrentContextMessage.DisplayName or targetUsername)
            if BlockMessageUser(targetUsername) then
                ShowLocalSystemMessage("[KRONOS] : Blocked " .. targetDisplayName .. ". Their messages are hidden for this session.")
            end
        end)
    end

    -- Edit/Delete are deliberately available only for the local player's
    -- own normal messages. Bot/system/sticker/invite messages cannot be edited.
    if CurrentContextMessage
        and tostring(CurrentContextMessage.Username or "") == tostring(LocalPlayer.Name)
        and not CurrentContextMessage.SystemMessage
        and not CurrentContextMessage.IsMusicSessionInvite
        and not CurrentContextMessage.IsServerInvite
        and not CurrentContextMessage.IsProfileShare
        and not CurrentContextMessage.IsSticker
        and not CurrentContextMessage.Deleted then

        AddContextMenuButton("Delete Message", 5, function()
            if not CurrentContextMessage then return end
            local target = CurrentContextMessage
            local endpoint = (ActiveTab == "GLOBAL") and GLOBAL_MESSAGES_ENDPOINT or SERVER_MESSAGES_ENDPOINT
            local clientId = tostring(target.ClientMessageId or "")
            if clientId == "" then
                ShowLocalSystemMessage("[AI MoD] : This message cannot be deleted.", true)
                return
            end

            -- Register the pending deletion BEFORE touching the UI.  This prevents
            -- the polling loop from recreating the old Firebase copy during the
            -- small window while the delete request is travelling.
            local deletedAt = os.time()
            PendingMessageMutations[clientId] = {
                Deleted = true,
                DeletedAt = deletedAt,
                DeletedBy = LocalPlayer.Name,
                MutationType = "DELETE",
            }

            local cache = (ActiveTab == "GLOBAL") and GlobalCachedMessages or ServerCachedMessages
            for key, value in pairs(cache) do
                if type(value) == "table" and tostring(value.ClientMessageId or "") == tostring(target.ClientMessageId or "") then
                    cache[key] = nil
                end
            end
            for _, card in ipairs((ActiveTab == "GLOBAL") and GlobalUIElements or ServerUIElements) do
                if card and card.Parent and tostring(card:GetAttribute("ClientMessageId") or "") == tostring(target.ClientMessageId or "") then
                    card:Destroy()
                end
            end

            -- Delete every Firebase record carrying this ClientMessageId, with
            -- verification/retries.  A local-only disappearance is not enough:
            -- the authoritative Firebase record must be gone before the pending
            -- mutation is cleared, otherwise polling can resurrect the message.
            task.spawn(function()
                local confirmed = false
                for attempt = 1, 4 do
                    local keys = FindAllFirebaseMessageKeys(endpoint, clientId)
                    if #keys == 0 then
                        confirmed = true
                        break
                    end
                    for _, firebaseKey in ipairs(keys) do
                        pcall(function()
                            HttpRequest(endpoint .. "/" .. tostring(firebaseKey) .. ".json", "DELETE")
                        end)
                    end
                    task.wait(0.35)
                    local remaining = FindAllFirebaseMessageKeys(endpoint, clientId)
                    if #remaining == 0 then
                        confirmed = true
                        break
                    end
                end
                if confirmed then
                    PendingMessageMutations[clientId] = nil
                else
                    ShowLocalSystemMessage("[AI MoD] : Firebase did not confirm deletion. The message is being kept hidden locally while the delete is retried.", true)
                end
            end)

            EditingContextMessage = nil
            EditingContextIsGlobal = false
            ShowLocalSystemMessage("[AI MoD] : Message deleted.")
        end)
    end

    -- Remove all unused vertical space when conditional options are absent.
    -- Every context-menu button is 40px tall, so the menu height follows the
    -- exact number of valid options instead of reserving space for invalid ones.
    local optionCount = 0
    for _, child in ipairs(ContextMenu:GetChildren()) do
        if child:IsA("TextButton") then
            optionCount = optionCount + 1
        end
    end
    ContextMenu.Size = UDim2.new(0, 170, 0, optionCount * 40)
end

