function StartOwnMusicSession()
    if ActiveMusicSessionId then
        ShowLocalSystemMessage("[AI MoD] : You already have a Music Session: " .. ActiveMusicSessionId)
        return
    end
    local id = MusicSessionRandomId()
    local payload = {
        SessionId = id,
        HostUsername = LocalPlayer.Name,
        HostDisplayName = GetFormattedDisplayName(LocalPlayer.DisplayName, true),
        HostUserId = LocalPlayer.UserId,
        HostPfpId = CurrentPfpId,
        Playing = false,
        Ended = false,
        CurrentSongId = "",
        CurrentSongName = "",
        StartedAt = 0,
        UpdatedAt = os.time(),
        Revision = tostring(os.time()),
        CreatedAt = os.time(),
    }
    local result = HttpRequest(MusicSessionPath(id), "PUT", payload)
    if result ~= nil or HttpRequest(MusicSessionPath(id), "GET") then
        ActiveMusicSessionId = id
        ActiveMusicSessionData = payload
        MusicSessionLastRevision = nil
        UpdateMusicSessionDisplay()
        UpdateMusicSessionMode()
        ShowLocalSystemMessage("[AI MoD] : Music Session started. Session ID: " .. id)
    else
        ShowLocalSystemMessage("[AI MoD] : Failed to create Music Session. Check Firebase access.", true)
    end
end

function JoinMusicSessionById(id)
    id = tostring(id or ""):upper():gsub("%s+", "")
    if id == "" then
        ShowLocalSystemMessage("[AI MoD] : Enter a Session ID first.", true)
        return
    end
    local data = HttpRequest(MusicSessionPath(id), "GET")
    if type(data) ~= "table" or not data.HostUsername or data.Ended == true then
        ShowLocalSystemMessage("[AI MoD] : Music Session not found or already ended: " .. id, true)
        return
    end
    ActiveMusicSessionId = id
    ActiveMusicSessionData = data
    MusicSessionLastRevision = nil
    HttpRequest(MusicSessionUrl(id, "/members/" .. tostring(LocalPlayer.UserId)), "PUT", {
        Username = LocalPlayer.Name,
        DisplayName = GetFormattedDisplayName(LocalPlayer.DisplayName, true),
        JoinedAt = os.time(),
        PfpId = CurrentPfpId,
    })
    ApplyMusicSessionAudio(data)
    UpdateMusicSessionDisplay()
    UpdateMusicSessionMode()
    ShowLocalSystemMessage("[AI MoD] : Joined Music Session " .. id .. " hosted by " .. tostring(data.HostDisplayName or data.HostUsername) .. " ✓")
end

function LeaveOrEndMusicSession()
    local id = ActiveMusicSessionId
    local sessionData = ActiveMusicSessionData

    if not id then
        ResetMusicSessionToChoiceMenu()
        return
    end

    local isHost = sessionData and sessionData.HostUsername == LocalPlayer.Name
    local sessionIdForRemoteWrite = id

    if isHost then
        local endedPayload = {
            Ended = true,
            Playing = false,
            CurrentSongId = "",
            CurrentSongName = "",
            StartedAt = 0,
            UpdatedAt = os.time(),
            EndedAt = os.time(),
            Revision = tostring(os.time()) .. "_ended_" .. tostring(math.random(100000,999999)),
            HostUsername = LocalPlayer.Name,
            HostDisplayName = GetFormattedDisplayName(LocalPlayer.DisplayName, true),
            HostUserId = LocalPlayer.UserId,
            HostPfpId = CurrentPfpId,
            SessionId = sessionIdForRemoteWrite,
        }

        -- CRITICAL: local audio + local UI are reset BEFORE Firebase.
        -- Therefore End Session ALWAYS stops this client and returns to choices.
        ResetMusicSessionToChoiceMenu()

        task.spawn(function()
            pcall(function()
                HttpRequest(MusicSessionPath(sessionIdForRemoteWrite), "PUT", endedPayload)
            end)
        end)
    else
        -- CRITICAL: participant also exits locally BEFORE Firebase.
        ResetMusicSessionToChoiceMenu()

        task.spawn(function()
            pcall(function()
                HttpRequest(
                    MusicSessionUrl(sessionIdForRemoteWrite, "/members/" .. tostring(LocalPlayer.UserId)),
                    "DELETE"
                )
            end)
        end)
    end
end


function HostSetMusic(id, name)
    if not ActiveMusicSessionId or not ActiveMusicSessionData or ActiveMusicSessionData.HostUsername ~= LocalPlayer.Name then
        ShowLocalSystemMessage("[AI MoD] : Start/host a Music Session first.", true)
        return
    end
    id = tostring(id or ""):match("%d+") or ""
    if id == "" then
        ShowLocalSystemMessage("[AI MoD] : Enter a valid Roblox Music ID.", true)
        return
    end
    name = name or GetMusicSongName(id)
    local payload = {
        Playing = true,
        Ended = false,
        CurrentSongId = id,
        CurrentSongName = tostring(name),
        StartedAt = os.time(),
        UpdatedAt = os.time(),
        Revision = tostring(os.time()) .. "_" .. tostring(math.random(1000,9999)),
        HostUsername = LocalPlayer.Name,
        HostDisplayName = GetFormattedDisplayName(LocalPlayer.DisplayName, true),
        HostUserId = LocalPlayer.UserId,
        HostPfpId = CurrentPfpId,
        SessionId = ActiveMusicSessionId,
    }
    HttpRequest(MusicSessionPath(ActiveMusicSessionId), "PATCH", payload)
    ActiveMusicSessionData = payload
    MusicSessionLastRevision = nil
    MusicSessionStopPendingId = nil
    ApplyMusicSessionAudio(payload)
    UpdateMusicSessionDisplay()
end

function HostStopMusic()
    local id = ActiveMusicSessionId
    local sessionData = ActiveMusicSessionData
    if not id or not sessionData or sessionData.HostUsername ~= LocalPlayer.Name then
        ShowLocalSystemMessage("[AI MoD] : Only the Music Session Host can stop music.", true)
        return
    end

    local payload = {
        Playing = false,
        Ended = false,
        CurrentSongId = sessionData.CurrentSongId or "",
        CurrentSongName = sessionData.CurrentSongName or "",
        StartedAt = 0,
        UpdatedAt = os.time(),
        Revision = tostring(os.time()) .. "_stop_" .. tostring(math.random(100000,999999)),
        HostUsername = LocalPlayer.Name,
        HostDisplayName = GetFormattedDisplayName(LocalPlayer.DisplayName, true),
        HostUserId = LocalPlayer.UserId,
        HostPfpId = CurrentPfpId,
        SessionId = id,
    }

    -- Stop the host immediately. Do not wait for Firebase to respond.
    ActiveMusicSessionData = payload
    MusicSessionLastRevision = payload.Revision
    MusicSessionStopPendingId = id
    StopLocalMusicSessionAudio()
    MusicSessionSound.Volume = 0.5
    UpdateMusicSessionDisplay()

    -- Publish the authoritative stopped state for every participant.
    task.spawn(function()
        pcall(function()
            HttpRequest(MusicSessionPath(id), "PUT", payload)
        end)
    end)
end

function SendMusicSessionInvite(isGlobal)
    if not ActiveMusicSessionId or not ActiveMusicSessionData then
        ShowLocalSystemMessage("[AI MoD] : Start or join a Music Session first.", true)
        return
    end
    local payload = {
        ClientMessageId = LocalPlayer.UserId .. "_musicinvite_" .. tostring(math.floor(os.clock() * 1000000)) .. "_" .. tostring(math.random(100000,999999)),
        Username = KRONO_JOCKIE_USERNAME,
        DisplayName = KRONO_JOCKIE_NAME,
        Text = GetFormattedDisplayName(LocalPlayer.DisplayName, true) .. " invited you to join their Music Session",
        Timestamp = os.time(),
        Role = "BOT",
        PfpId = KRONO_JOCKIE_PFP,
        IsPrivate = false,
        IsMusicSessionInvite = true,
        MusicSessionId = ActiveMusicSessionId,
        MusicSessionHostUsername = ActiveMusicSessionData.HostUsername,
        MusicSessionHostDisplayName = ActiveMusicSessionData.HostDisplayName,
        MusicSessionHostPfpId = ActiveMusicSessionData.HostPfpId or CurrentPfpId,
    }
    local endpoint = isGlobal and GLOBAL_MESSAGES_ENDPOINT or SERVER_MESSAGES_ENDPOINT
    local cache = isGlobal and GlobalCachedMessages or ServerCachedMessages
    local ui = isGlobal and GlobalUIElements or ServerUIElements
    local localKey = "local_" .. payload.ClientMessageId
    cache[localKey] = payload
    local card = CreateMessageCard(payload, isGlobal)
    card.Visible = (ActiveTab == (isGlobal and "GLOBAL" or "SERVER"))
    table.insert(ui, card)
    task.spawn(function() HttpRequest(endpoint, "POST", payload) end)
end

