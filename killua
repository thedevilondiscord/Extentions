local function RefreshMusicSessionState()
    if not ActiveMusicSessionId then
        StopLocalMusicSessionAudio()
        return
    end

    local sessionIdAtRequest = ActiveMusicSessionId
    local data = HttpRequest(MusicSessionPath(sessionIdAtRequest), "GET")

    -- Do NOT treat a temporary Firebase/network failure as an ended session.
    -- Only an explicit Ended=true or a confirmed Playing=false is authoritative.
    if type(data) ~= "table" then
        return
    end

    if sessionIdAtRequest ~= ActiveMusicSessionId then
        return
    end

    if data.Ended == true then
        ResetMusicSessionToChoiceMenu()
        return
    end

    ActiveMusicSessionData = data

    -- Prevent the polling loop from immediately restarting old music while the
    -- host's stop write is still travelling to Firebase.
    if MusicSessionStopPendingId == sessionIdAtRequest then
        -- Host pressed STOP. Until Firebase confirms Playing=false, this
        -- client is forbidden from restarting the previous song.
        if data.Playing == false then
            MusicSessionStopPendingId = nil
        else
            StopLocalMusicSessionAudio()
            return
        end
    end

    local revision = tostring(data.Revision or data.UpdatedAt or data.CurrentSongId or data.Playing)

    if data.Playing == true and data.CurrentSongId then
        if revision ~= MusicSessionLastRevision or not MusicSessionSound.IsPlaying then
            MusicSessionLastRevision = revision
            ApplyMusicSessionAudio(data)
        else
            MusicSessionSound.Volume = MusicSessionMuted and 0 or 0.5
        end
    else
        -- Playing=false is authoritative. Stop immediately even if the
        -- revision happens to be unchanged.
        MusicSessionLastRevision = revision
        StopLocalMusicSessionAudio()
    end
end

