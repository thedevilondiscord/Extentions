local function trim(s)
    return tostring(s or ""):gsub("^%s+",""):gsub("%s+$","")
end
local function lower(s) return string.lower(tostring(s or "")) end
local function safeText(s,max)
    s=tostring(s or "")
    if max and #s>max then return s:sub(1,max) end
    return s
end

local function normalizeId(v)
    if v==nil then return nil end
    local s=tostring(v)
    local digits=s:match("%d+")
    return digits and digits or nil
end

local function findPlayer(query)
    query=lower(trim(query))
    if query=="" then return nil end
    local players=Players:GetPlayers()
    for _,p in ipairs(players) do if lower(p.DisplayName)==query then return p end end
    for _,p in ipairs(players) do if lower(p.Name)==query then return p end end
    local found=nil
    for _,p in ipairs(players) do
        if lower(p.DisplayName):sub(1,#query)==query or lower(p.Name):sub(1,#query)==query then
            if found then return nil end
            found=p
        end
    end
    return found
end

local function playerIdentity()
    return Players.LocalPlayer.UserId,Players.LocalPlayer.Name,Players.LocalPlayer.DisplayName
end

local roleRoster=nil
local permissionRoster=nil
local verifiedRoles={}
local highestRole=nil
local permissionCache={}

local function valueMatchesIdentity(v,userId,username)
    local uid=tostring(userId or "")
    local uname=lower(username or "")
    if type(v)=="string" or type(v)=="number" then
        return tostring(v)==uid or lower(tostring(v))==uname
    end
    if type(v)~="table" then return false end
    for field,value in pairs(v) do
        local f=lower(field)
        if f=="userid" or f=="userid" or f=="id" or f=="encodedid" then
            if tostring(value)==uid then return true end
        elseif f=="username" or f=="name" then
            if lower(tostring(value))==uname then return true end
        elseif f=="userids" or f=="usernames" or f=="names" or f=="ids" or f=="encodedids" or f=="userids" then
            if type(value)=="table" then
                for _,item in pairs(value) do
                    if tostring(item)==uid or lower(tostring(item))==uname then return true end
                end
            end
        end
    end
    for _,child in pairs(v) do
        if type(child)=="table" and valueMatchesIdentity(child,userId,username) then return true end
    end
    return false
end

local function recursiveMatch(node,role,userId,username)
    if type(node)~="table" then return false end
    for k,v in pairs(node) do
        if tostring(k)==role and valueMatchesIdentity(v,userId,username) then
            return true
        end
        if type(v)=="table" and recursiveMatch(v,role,userId,username) then
            return true
        end
    end
    return false
end

local function fetchRoles()
    local data=executorRequest(ROLE_URL,"GET")
    if type(data)~="table" then return false end
    roleRoster=data
    local uid,name=Players.LocalPlayer.UserId,Players.LocalPlayer.Name
    verifiedRoles={}
    for _,role in ipairs(ROLE_ORDER) do
        if recursiveMatch(data,role,uid,name) then table.insert(verifiedRoles,role) end
    end
    highestRole=nil
    for _,role in ipairs(ROLE_ORDER) do
        for _,r in ipairs(verifiedRoles) do
            if r==role then highestRole=role break end
        end
        if highestRole then break end
    end
    return true
end

local function fetchPermissions()
    local data=executorRequest(PERMISSION_URL,"GET")
    if type(data)~="table" or next(data)==nil then
        permissionRoster=nil
        permissionCache={}
        return false
    end
    permissionRoster=data
    permissionCache={}
    for _,role in ipairs(verifiedRoles) do
        local entry=data[role]
        if type(entry)=="table" then
            for k,v in pairs(entry) do if v==true then permissionCache[k]=true end end
        end
    end
    return true
end

local function hasPermission(permission)
    return permission=="" or permissionCache[permission] == true
end
local function hasRole(role)
    for _,r in ipairs(verifiedRoles) do if r==role then return true end end
    return false
end

