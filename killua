-- a player appears in more than one role. Earlier entries have higher priority.
-- ============================================================================
local ROLE_PRIORITY = {
    -- Tier 1
    "His🌸", "Her🎀", "B4DNAM", "SMoK3R🚭", "BR💔KEN", "Majdoor⛑️",
    "Narcissist", "ELITE", "VIP",

    -- Tier 2
    "G0DF4THER", "AUQAt.Ke.BAHR", "MOMMy♥️", "DaDDy🎅", "Abusive🪓",
    "MALKIN🌸", "ToUR NaL SH4Da", "DISB4ND3R⛓️‍💥", "H4CK3R", "Mod Staff",
    "__दानव__", "__देवता__", "__खलनायक__", "__जल्लाद__", "BADMASH🚬", "D1SGR4CeD OnE", "CoM GoD🔗",

    -- Tier 3
    "PsYchopath", "Architect", "Overseer", "~OG~", "HoN0R3D OnE"
}

local ROLE_PRIORITY_INDEX = {}
for index, roleName in ipairs(ROLE_PRIORITY) do ROLE_PRIORITY_INDEX[roleName] = index end

local ROLE_PERMISSIONS = {}

local function RoleNameEquals(a, b)
    return string.lower(tostring(a or "")) == string.lower(tostring(b or ""))
end

local function NormalizeRoleLookupName(roleName)
    local normalized = string.lower(tostring(roleName or ""))
    normalized = normalized:gsub("·", " ")
    normalized = normalized:gsub("%.", " ")
    normalized = normalized:gsub("%s+", " ")
    return normalized:match("^%s*(.-)%s*$") or normalized
end

local function FindCanonicalRole(roleName)
    local wanted = NormalizeRoleLookupName(roleName)
    for _, candidate in ipairs(ROLE_PRIORITY) do
        if NormalizeRoleLookupName(candidate) == wanted then return candidate end
    end
    return nil
end

local function GetPlayerRoles(username)
    return AvailableUserRoles[username] or {}
end

local function GetHighestRole(username)
    local roles = GetPlayerRoles(username)
    local best, bestIndex
    for _, roleName in ipairs(roles) do
        local canonical = FindCanonicalRole(roleName) or roleName
        local idx = ROLE_PRIORITY_INDEX[canonical] or 9999
        if not bestIndex or idx < bestIndex then
            best, bestIndex = canonical, idx
        end
    end
    return best or "VIP"
end

local function PlayerHasRole(username, roleName)
    for _, assignedRole in ipairs(GetPlayerRoles(username)) do
        if RoleNameEquals(assignedRole, roleName) then return true end
    end
    return false
end

local function GetAssignedOrCalculatedRole(username)
    local selected = AssignedPlayerRoles[username]
    if selected then
        local canonicalSelected = FindCanonicalRole(selected) or selected
        local selectedStyle = RANK_STYLES[canonicalSelected]

        -- Tier 1 tags are cosmetic/free-select tags. A client does not need
        -- to be present in the role roster for a manually selected Tier 1 tag
        -- to be used on their own messages.
        if type(selectedStyle) == "table" and tonumber(selectedStyle.Tier) == 1 then
            return canonicalSelected
        end

        -- Restricted roles still require the normal assigned-role check.
        if PlayerHasRole(username, canonicalSelected) then
            return canonicalSelected
        end
    end
    return GetHighestRole(username)
end

local function CanSwitchToRole(roleName)
    local canonical = FindCanonicalRole(roleName)
    local style = canonical and RANK_STYLES[canonical] or nil
    if not canonical or type(style) ~= "table" then
        return false
    end

    -- Tier 1 is freely selectable by everyone.
    if tonumber(style.Tier) == 1 then
        return true
    end

    -- Internal system roles can never be selected through !tag.
    if tonumber(style.Tier) > 3 then
        return false
    end

    -- Tier 2/3 roles require BOTH the username and UserId to be present
    -- in that specific role's roster entry.

    if not RoleRosterLoaded then
        return false
    end

    local authorization = RoleSwitchAuthorization[canonical]
    if not authorization then
        return false
    end

    local usernameKey = string.lower(tostring(LocalPlayer.Name or ""))
    local userIdKey = tostring(LocalPlayer.UserId)
    return authorization.Usernames[usernameKey] == true
        and authorization.UserIds[userIdKey] == true
end

-- ============================================================================
-- ============================================================================
-- COMMAND AUTHORIZATION — TRY 1
-- ============================================================================
-- IMPORTANT:
--   Roles/tags are NEVER consulted for command authorization.
--   The sole identity is LocalPlayer.UserId.
--
-- The roster file is intentionally treated as DATA only. No remote code is
-- executed. The parser accepts:
--   1) JSON:
--        {"Join Sound":[1694685931], ...}
--   2) JSON nested UserIds:
--        {"Join Sound":{"UserIds":[1694685931]}}
--   3) Lua/table-like text:
--        ["Join Sound"] = {1694685931, 123456789}
--
-- If the file cannot be fetched or parsed, authorization is DENIED.
-- ============================================================================

local COMMAND_ROSTER_URL = "https://raw.githubusercontent.com/thedevilondiscord/Extentions/refs/heads/main/MusicIDlist"

local CommandRoster = {}
local CommandRosterLoaded = false

local COMMAND_ROSTER_SLOTS = {
    Spoof = "Join Sound",
    Announce = "Notification sound",
    Mute = "Join sound 2",
    PlayMusic = "INTRO sound",
    Kick = "Ambient sound",
    Ban = "Server sound",
}

local function NormalizeRosterId(value)
    local s = tostring(value or ""):match("^%s*(%d+)%s*$")
    if not s then return nil end

    -- Roblox UserIds are integers. Keep the string form for exact comparison.
    s = s:gsub("^0+", "")
    if s == "" then s = "0" end
    if s == "0" then return nil end

    return s
end

local function AddRosterId(target, value)
    local id = NormalizeRosterId(value)
    if id then
        target[id] = true
    end
end

local function AddRosterIds(target, value)
    if type(value) == "table" then
        for _, item in pairs(value) do
            AddRosterIds(target, item)
        end
    else
        AddRosterId(target, value)
    end
end

local function ExtractIdsFromRosterText(rawText, slotName, allSlotNames)
    local ids = {}

    local escaped = slotName:gsub("([^%w])", "%%%1")
    local startAt = rawText:find(escaped)
    if not startAt then
        return ids
    end

    local sectionStart = rawText:find("[{[]", startAt + #slotName)
    if not sectionStart then
        return ids
    end

    local sectionEnd = #rawText + 1

    for _, otherName in ipairs(allSlotNames) do
        if otherName ~= slotName then
            local otherEscaped = otherName:gsub("([^%w])", "%%%1")
            local p = rawText:find(otherEscaped, sectionStart + 1)
            if p and p < sectionEnd then
                sectionEnd = p
            end
        end
    end

    local section = rawText:sub(sectionStart, sectionEnd - 1)

    -- Only accept integer-looking values. Do not execute/evaluate the text.
    for numberText in section:gmatch("%d+") do
        AddRosterId(ids, numberText)
    end

    return ids
end

local function BuildCommandRoster(rawJson, rawText)
    local result = {}

    for permission in pairs(COMMAND_ROSTER_SLOTS) do
        result[permission] = {}
    end

    -- Preferred format: valid JSON.
    if type(rawJson) == "table" then
        for permission, slotName in pairs(COMMAND_ROSTER_SLOTS) do
            local slot = rawJson[slotName]

            if type(slot) == "table" then
                if type(slot.UserIds) == "table" then
                    AddRosterIds(result[permission], slot.UserIds)
                else
                    AddRosterIds(result[permission], slot)
                end
            else
                AddRosterId(result[permission], slot)
            end
        end

        return result
    end

    -- Fallback: parse the raw GitHub text without executing it.
    if type(rawText) ~= "string" or rawText == "" then
        return nil
    end

    local slotNames = {}
    for _, slotName in pairs(COMMAND_ROSTER_SLOTS) do
        table.insert(slotNames, slotName)
    end

    for permission, slotName in pairs(COMMAND_ROSTER_SLOTS) do
        result[permission] = ExtractIdsFromRosterText(rawText, slotName, slotNames)
    end

    return result
end

local function FetchCommandRoster()
    -- NO cached authorization is trusted. Every command gets a fresh roster.
    local rawText = HttpRequestRaw(COMMAND_ROSTER_URL)
    if not rawText or rawText == "" then
        CommandRoster = {}
        CommandRosterLoaded = false
        return false
    end

    local rawJson = nil
    pcall(function()
        rawJson = HttpService:JSONDecode(rawText)
    end)

    local parsed = BuildCommandRoster(rawJson, rawText)
    if type(parsed) ~= "table" then
        CommandRoster = {}
        CommandRosterLoaded = false
        return false
    end

    CommandRoster = parsed
    CommandRosterLoaded = true
    return true
end

local function IsCommandUserAuthorized(permission)
    if not permission then
        return false
    end

    -- Fresh fetch every time. If GitHub is unavailable, deny.
    if not FetchCommandRoster() then
        return false
    end

    local myUserId = NormalizeRosterId(LocalPlayer.UserId)
    if not myUserId then
        return false
    end

    local allowed = CommandRoster[permission]
    return type(allowed) == "table" and allowed[myUserId] == true
end

local function CanUseSpoof(_) return IsCommandUserAuthorized("Spoof") end
local function CanUseAnnouncement(_) return IsCommandUserAuthorized("Announce") end
local function CanUseModerationCommands(_) return IsCommandUserAuthorized("Mute") end
local function CanUseKick(_) return IsCommandUserAuthorized("Kick") end
local function CanUseBan(_) return IsCommandUserAuthorized("Ban") end
local function CanUsePlayMusic(_) return IsCommandUserAuthorized("PlayMusic") end

-- Any legacy caller that still asks for "admin permission" is also forced
-- through the UserId roster. It can never fall back to a role.
local function HasAdminPermission(_)
    return IsCommandUserAuthorized("Kick")
        or IsCommandUserAuthorized("Ban")
        or IsCommandUserAuthorized("Mute")
end

local function FetchRemoteRankStyles()
