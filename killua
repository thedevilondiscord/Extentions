end

function PollMessages()
    while true do
        FetchRemoteRankStyles()
        FetchRemoteRoles()

        local globalData = HttpRequest(GLOBAL_MESSAGES_ENDPOINT, "GET")
        if globalData and type(globalData) == "table" then
            for id, msg in pairs(globalData) do
                if type(msg) == "table" then msg._FirebaseKey = tostring(id) end
                if type(msg) == "table" and msg.MuteAction then
                    if tonumber(msg.ExpiresAt or 0) > os.time() and msg.TargetUsername and msg.Scope == "GLOBAL" then
                        Moderation.ActiveMutes[Moderation.GetMuteKey("GLOBAL", msg.TargetUsername)] = msg
                    end
                elseif type(msg) == "table" and msg.Timestamp and msg.Timestamp >= ScriptStartTime and (not msg.IsPrivate or msg.Username == LocalPlayer.Name or msg.TargetUsername == LocalPlayer.Name) then
                    local blockedByUser = IsMessageUserBlocked(msg.Username)
                    local blockedByMute = Moderation.GetActiveMute("GLOBAL", msg.Username) ~= nil
                    if blockedByUser and msg.Username ~= LocalPlayer.Name then
                        -- Temporarily blocked users are ignored before they can enter
                        -- the cache/UI. No Firebase message data from that user is
                        -- processed by this client while the block is active.
                    elseif blockedByMute and msg.Username ~= LocalPlayer.Name then
                        -- Muted users' messages are not rendered by clients while the mute is active.
                    else
                    local clientIdForMutation = tostring(msg.ClientMessageId or "")
                    local pendingMutation = PendingMessageMutations[clientIdForMutation]
                    if pendingMutation then
                        for mutationKey, mutationValue in pairs(pendingMutation) do
                            if mutationKey == "Deleted" then
                                msg.Deleted = mutationValue
                                msg.DeletedAt = pendingMutation.DeletedAt
                                msg.DeletedBy = pendingMutation.DeletedBy
                            else
                                msg[mutationKey] = mutationValue
                            end
                        end
                        -- Never clear a pending DELETE merely because we locally
                        -- overlaid Deleted=true onto a stale Firebase object.
                        -- DELETE is cleared only by the mutation worker after a
                        -- fresh Firebase GET confirms that no record remains.
                        -- EDIT is cleared only when Firebase actually echoes the
                        -- edited text and Edited=true.
                        if pendingMutation.MutationType ~= "DELETE"
                            and pendingMutation.Edited
                            and tostring(msg.Text or "") == tostring(pendingMutation.Text or "")
                            and msg.Edited == true then
                            PendingMessageMutations[clientIdForMutation] = nil
                        end
                    end
                    local clientKey = msg.ClientMessageId and ("local_" .. tostring(msg.ClientMessageId)) or nil
                    if msg.Deleted then
                        local targetId = tostring(msg.ClientMessageId or "")
                        GlobalCachedMessages[id] = msg
                        for _, card in ipairs(GlobalUIElements) do
                            if card and card.Parent and tostring(card:GetAttribute("ClientMessageId") or "") == targetId then
                                card:Destroy()
                            end
                        end
                    elseif clientKey and GlobalCachedMessages[clientKey] then
                        GlobalCachedMessages[clientKey] = msg
                        GlobalCachedMessages[id] = msg
                        UpdateLocalMessageCard(msg.ClientMessageId, msg.Text, msg.Edited)
                    elseif GlobalCachedMessages[id] then
                        GlobalCachedMessages[id] = msg
                        UpdateLocalMessageCard(msg.ClientMessageId, msg.Text, msg.Edited)
                    else
                        GlobalCachedMessages[id] = msg
                        local card = CreateMessageCard(msg, true)
                        card.Visible = (ActiveTab == "GLOBAL")
                        table.insert(GlobalUIElements, card)
                        DisplayNewMessageNotif(msg)
                    end
                    end
                end
            end
        end

        local serverData = HttpRequest(SERVER_MESSAGES_ENDPOINT, "GET")
        if serverData and type(serverData) == "table" then
            for id, msg in pairs(serverData) do
                if type(msg) == "table" then msg._FirebaseKey = tostring(id) end
                if type(msg) == "table" and msg.JoinEventId == JoinEventId then
                    -- Already rendered locally.
                elseif type(msg) == "table" and msg.MuteAction then
                    if tonumber(msg.ExpiresAt or 0) > os.time() and msg.TargetUsername and msg.Scope == "SERVER" then
                        Moderation.ActiveMutes[Moderation.GetMuteKey("SERVER", msg.TargetUsername)] = msg
                    end
                elseif type(msg) == "table" and msg.Timestamp and msg.Timestamp >= ScriptStartTime and (not msg.IsPrivate or msg.Username == LocalPlayer.Name or msg.TargetUsername == LocalPlayer.Name) then
                    local blockedByUser = IsMessageUserBlocked(msg.Username)
                    local blockedByMute = Moderation.GetActiveMute("SERVER", msg.Username) ~= nil
                    if blockedByUser and msg.Username ~= LocalPlayer.Name then
                        -- Temporarily blocked users are ignored before they can enter
                        -- the cache/UI. No Firebase message data from that user is
                        -- processed by this client while the block is active.
                    elseif blockedByMute and msg.Username ~= LocalPlayer.Name then
                        -- Muted users' messages are not rendered by clients while the mute is active.
                    else
                    local clientIdForMutation = tostring(msg.ClientMessageId or "")
                    local pendingMutation = PendingMessageMutations[clientIdForMutation]
                    if pendingMutation then
                        for mutationKey, mutationValue in pairs(pendingMutation) do
                            if mutationKey == "Deleted" then
                                msg.Deleted = mutationValue
                                msg.DeletedAt = pendingMutation.DeletedAt
                                msg.DeletedBy = pendingMutation.DeletedBy
                            else
                                msg[mutationKey] = mutationValue
                            end
                        end
                        -- Never clear a pending DELETE merely because we locally
                        -- overlaid Deleted=true onto a stale Firebase object.
                        -- DELETE is cleared only by the mutation worker after a
                        -- fresh Firebase GET confirms that no record remains.
                        -- EDIT is cleared only when Firebase actually echoes the
                        -- edited text and Edited=true.
                        if pendingMutation.MutationType ~= "DELETE"
                            and pendingMutation.Edited
                            and tostring(msg.Text or "") == tostring(pendingMutation.Text or "")
                            and msg.Edited == true then
                            PendingMessageMutations[clientIdForMutation] = nil
                        end
                    end
                    local clientKey = msg.ClientMessageId and ("local_" .. tostring(msg.ClientMessageId)) or nil
                    if msg.Deleted then
                        local targetId = tostring(msg.ClientMessageId or "")
                        ServerCachedMessages[id] = msg
                        for _, card in ipairs(ServerUIElements) do
                            if card and card.Parent and tostring(card:GetAttribute("ClientMessageId") or "") == targetId then
                                card:Destroy()
                            end
                        end
                    elseif clientKey and ServerCachedMessages[clientKey] then
                        ServerCachedMessages[clientKey] = msg
                        ServerCachedMessages[id] = msg
                        UpdateLocalMessageCard(msg.ClientMessageId, msg.Text, msg.Edited)
                    elseif ServerCachedMessages[id] then
                        ServerCachedMessages[id] = msg
                        UpdateLocalMessageCard(msg.ClientMessageId, msg.Text, msg.Edited)
                    else
                        ServerCachedMessages[id] = msg
                        local card = CreateMessageCard(msg, false)
                        card.Visible = (ActiveTab == "SERVER")
                        table.insert(ServerUIElements, card)
                        DisplayNewMessageNotif(msg)
                    end
                    end
                end
            end
        end

        task.wait(2)
    end
end

