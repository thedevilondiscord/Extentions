-- PERSISTENT CUSTOM STICKERS
-- The saved list is local to this client and is deliberately stored separately
-- from the built-in roster. New custom stickers are always inserted first.
-- ============================================================================
CUSTOM_STICKERS_SAVE_KEY = "Kronos_CustomStickers"
PersistentCustomStickers = {}

function LoadPersistentCustomStickers()
    if not (readfile and isfile and isfile(CUSTOM_STICKERS_SAVE_KEY .. ".txt")) then return end
    pcall(function()
        local raw = readfile(CUSTOM_STICKERS_SAVE_KEY .. ".txt")
        if raw and raw ~= "" then
            local decoded = HttpService:JSONDecode(raw)
            if type(decoded) == "table" then
                for _, id in ipairs(decoded) do
                    id = tostring(id or "")
                    if id:match("^%d+$") and not table.find(PersistentCustomStickers, id) then
                        table.insert(PersistentCustomStickers, id)
                    end
                end
            end
        end
    end)
end

function SavePersistentCustomStickers()
    if writefile then
        pcall(function()
            writefile(CUSTOM_STICKERS_SAVE_KEY .. ".txt", HttpService:JSONEncode(PersistentCustomStickers))
        end)
    end
end

function NormalizeStickerId(value)
    value = tostring(value or ""):gsub("^%s+", ""):gsub("%s+$", "")
    local id = value:match("^%d+$") or value:match("(%d+)")
    if not id then return nil end
    return id
end

