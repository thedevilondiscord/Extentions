local function SaveEditedMessage(message, newText, isGlobal)
    if not message or tostring(message.Username or "") ~= tostring(LocalPlayer.Name) then return false end
    local clientId = tostring(message.ClientMessageId or "")
    if clientId == "" then return false end
    newText = tostring(newText or "")
    if newText:match("^%s*$") then return false end

    local endpoint = isGlobal and GLOBAL_MESSAGES_ENDPOINT or SERVER_MESSAGES_ENDPOINT
    local patch = {
        Text = newText,
        Edited = true,
        EditedAt = os.time(),
        EditedBy = LocalPlayer.Name,
    }

    -- Keep the new value authoritative locally until Firebase itself confirms
    -- it.  Polling must never be allowed to overwrite an edit with stale data.
    PendingMessageMutations[clientId] = patch
    message.Text = newText
    message.Edited = true
    message.EditedAt = patch.EditedAt
    UpdateLocalMessageCard(clientId, newText, true)

    task.spawn(function()
        local confirmed = false
        for attempt = 1, 4 do
            local firebaseKeys = FindAllFirebaseMessageKeys(endpoint, clientId)
            if #firebaseKeys > 0 then
                for _, firebaseKey in ipairs(firebaseKeys) do
                    pcall(function()
                        HttpRequest(endpoint .. "/" .. tostring(firebaseKey) .. ".json", "PATCH", patch)
                    end)
                end
                task.wait(0.35)
                local latest = HttpRequest(endpoint, "GET")
                if type(latest) == "table" then
                    confirmed = true
                    for _, remote in pairs(latest) do
                        if type(remote) == "table" and tostring(remote.ClientMessageId or "") == clientId then
                            if tostring(remote.Text or "") ~= newText or remote.Edited ~= true then
                                confirmed = false
                                break
                            end
                        end
                    end
                end
                if confirmed then break end
            end
            task.wait(0.35)
        end

        if confirmed then
            PendingMessageMutations[clientId] = nil
        else
            ShowLocalSystemMessage("[AI MoD] : Firebase did not confirm the edit. The edited text will remain protected from stale polling while you are connected.", true)
        end
    end)
    return true
end

SendChatMessage = function()
    local typedText = MessageInput.Text or ""
    if typedText == "" or typedText:match("^%s*$") then return end

    -- Editing is a separate send path: it updates the original Firebase
    -- record instead of creating a new chat message.
    if EditingContextMessage then
        local editing = EditingContextMessage
        local isGlobalEdit = EditingContextIsGlobal
        if SaveEditedMessage(editing, typedText, isGlobalEdit) then
            MessageInput.Text = ""
            EditingContextMessage = nil
            EditingContextIsGlobal = false
            ReplyContextMessage = nil
            RefreshReplyUI()
            ShowLocalSystemMessage("[AI MoD] : Message edited ✓")
        end
        return
    end

    local isPrivate = IsPrivateModeActive()
    local privateTargetUsername = PrivateModeTargetUsername
    local privateTargetDisplayName = PrivateModeTargetDisplayName
    local privateBody = typedText

    -- ========================================================================
    -- ABSOLUTE COMMAND PREFLIGHT
    -- ========================================================================
    -- This runs before ANY command-specific branch. Therefore a role/tag can
    -- never accidentally bypass a later permission check.
    if not isPrivate then
        local commandToken = typedText:match("^%s*(![%w_]+)")
        if commandToken then
            local commandPermission = {
                ["!testnotif"] = "Announce",
                ["!notify"] = "Announce",
                ["!joined"] = "Announce",
                ["!announce"] = "Announce",
                ["!mute"] = "Mute",
                ["!role"] = "Spoof",
                ["!spoof"] = "Spoof",
                ["!gplymsc"] = "PlayMusic",
                ["!splymsc"] = "PlayMusic",
                ["!stpmsc"] = "PlayMusic",
            }

            local permission = commandPermission[commandToken]
            if permission then
                if not IsCommandUserAuthorized(permission) then
                    ShowLocalSystemMessage(
                        "[AI MoD] : You have not been granted permission to use this command by the Architect.",
                        true
                    )
                    MessageInput.Text = ""
                    return
                end
            end
        end
    end

    -- PVT is determined only by the stored recipient state.
    -- There is no special prefix in the TextBox to delete or accidentally edit.
    if isPrivate then
        if not privateTargetUsername then return end
        privateBody = typedText
        if privateBody:match("^%s*$") then return end
    end

    if not isPrivate then
        local currentScope = (ActiveTab == "GLOBAL") and "GLOBAL" or "SERVER"
        local ownMute = Moderation.GetActiveMute(currentScope, LocalPlayer.Name)
        if ownMute then
            local remaining = Moderation.FormatMuteRemaining((tonumber(ownMute.ExpiresAt) or os.time()) - os.time())
            local imposedBy = tostring(ownMute.ImposedByDisplayName or "Moderator")
            ShowLocalSystemMessage("[AI MoD] : 🔇 You can't chat for the next " .. remaining .. " due to a mute enforced by " .. imposedBy .. ".", true)
            MessageInput.Text = ""
            return
        end
    end

    if not isPrivate and typedText == "!testnotif" then
        if IsCommandUserAuthorized("Announce") then
            TestNotification()
            ShowLocalSystemMessage("[AI MoD] : Notification test triggered successfully ✓")
        else
            ShowLocalSystemMessage("[AI MoD] : You have not been granted permission to use this command by the Architect.", true)
        end
        MessageInput.Text = ""
        return
    elseif not isPrivate and typedText == "!notify" then
        if IsCommandUserAuthorized("Announce") then
            TestNotification()
            ShowLocalSystemMessage("[AI MoD] : Notification test triggered successfully ✓")
        else
            ShowLocalSystemMessage("[AI MoD] : You have not been granted permission to use this command by the Architect.", true)
        end
        MessageInput.Text = ""
        return
    elseif not isPrivate and typedText == "!joined" then
        if IsCommandUserAuthorized("Announce") then
            ShowLocalJoinMessage()
            ShowLocalSystemMessage("[AI MoD] : Join-message test triggered successfully ✓")
        else
            ShowLocalSystemMessage("[AI MoD] : You have not been granted permission to use this command by the Architect.", true)
        end
        MessageInput.Text = ""
        return
    elseif not isPrivate and string.sub(typedText, 1, 9) == "!announce" then
        if not CanUseAnnouncement(LocalPlayer.Name) then
            ShowLocalSystemMessage("[AI MoD] : You have not been granted permission to use this command by the Architect.", true)
            MessageInput.Text = ""
            return
        end
        local body = typedText:sub(10):gsub("^%s+", "")
        if body == "" then
            ShowLocalSystemMessage("[AI MoD] : Command failed. Usage: !announce [Text].", true)
            MessageInput.Text = ""
            return
        end
        if #body > 900 then
            ShowLocalSystemMessage("[AI MoD] : Command failed. Announcement must be 900 characters or fewer.", true)
            MessageInput.Text = ""
            return
        end
        Moderation.SendAnnouncement(body)
        MessageInput.Text = ""
        return
    elseif not isPrivate and string.sub(typedText, 1, 6) == "!mute " then
        if not CanUseModerationCommands(LocalPlayer.Name) then
            ShowLocalSystemMessage("[AI MoD] : You have not been granted permission to use this command by the Architect.", true)
            MessageInput.Text = ""
            return
        end
        local argsText = typedText:sub(7)
        local durationText, targetQuery = argsText:match("^(%d+)%s+(.+)$")
        local duration = tonumber(durationText)
        if not duration or duration < 1 or duration > 15 or not targetQuery or targetQuery:match("^%s*$") then
            ShowLocalSystemMessage("[AI MoD] : Command failed. Usage: !mute [1-15 minutes] [DisplayName / Username / prefix].", true)
            MessageInput.Text = ""
            return
        end
        local targetUsername, targetDisplayName = Moderation.ResolveModerationTarget(targetQuery)
        if not targetUsername then
            ShowLocalSystemMessage("[AI MoD] : Command failed. Player not found. Use their DisplayName, Username, or a unique prefix.", true)
            MessageInput.Text = ""
            return
        end
        Moderation.SendMute(targetUsername, targetDisplayName, duration)
        MessageInput.Text = ""
        return
    elseif not isPrivate and string.sub(typedText, 1, 5) == "!tag " then
        local requestedRole = string.sub(typedText, 6):gsub("^%s+", ""):gsub("%s+$", "")
        local canonical = FindCanonicalRole(requestedRole)
        local style = canonical and RANK_STYLES[canonical] or nil

        if not canonical or type(style) ~= "table" then
            ShowLocalSystemMessage("[AI MoD] : Unknown tag. Please use a valid role.", true)
        elseif not CanSwitchToRole(canonical) then
            ShowLocalSystemMessage("[AI MoD] : You have not been granted the \"" .. canonical .. "\" Tag by the Architect.", true)
        else
            AssignedPlayerRoles[LocalPlayer.Name] = canonical
            DisabledTags[LocalPlayer.Name] = nil
            ShowLocalSystemMessage("[AI MoD] : Tag changed successfully to " .. canonical .. " ✓")
        end
        MessageInput.Text = ""
        return
    elseif not isPrivate and typedText == "!tag" then
        DisabledTags[LocalPlayer.Name] = not DisabledTags[LocalPlayer.Name]
        ShowLocalSystemMessage("[AI MoD] : Tag display " .. (DisabledTags[LocalPlayer.Name] and "disabled" or "enabled") .. " ✓")
        MessageInput.Text = ""
        return
    elseif not isPrivate and string.sub(typedText, 1, 6) == "!role " then
        if not IsCommandUserAuthorized("Spoof") then
            ShowLocalSystemMessage("[AI MoD] : You have not been granted permission to use this command by the Architect.", true)
            MessageInput.Text = ""
            return
        end
        local targetQuery = string.sub(typedText, 7):gsub("^%s+", ""):gsub("%s+$", "")
        local targetUsername, targetDisplayName = Moderation.ResolveModerationTarget(targetQuery)
        if not targetUsername then
            ShowLocalSystemMessage("[AI MoD] : Command failed. Player not found.", true)
        else
            local roles = GetPlayerRoles(targetUsername)
            local highest = GetHighestRole(targetUsername)
            local text = #roles > 0 and table.concat(roles, ", ") or "No assigned roles"
            ShowLocalSystemMessage("[AI MoD] : " .. targetDisplayName .. " — Highest: " .. highest .. " | Roles: " .. text)
        end
        MessageInput.Text = ""
        return
    elseif not isPrivate and typedText == "!role" then
        if not IsCommandUserAuthorized("Spoof") then
            ShowLocalSystemMessage("[AI MoD] : You have not been granted permission to use this command by the Architect.", true)
            MessageInput.Text = ""
            return
        end
        local roles = GetPlayerRoles(LocalPlayer.Name)
        local highest = GetHighestRole(LocalPlayer.Name)
        ShowLocalSystemMessage("[AI MoD] : Your highest role is " .. highest .. ". Assigned roles: " .. (#roles > 0 and table.concat(roles, ", ") or "none") .. ".")
        MessageInput.Text = ""
        return
    elseif not isPrivate and string.sub(typedText, 1, 7) == "!spoof " then
        local requested = string.sub(typedText, 8)
        local lowered = string.lower(requested)
        if lowered == "architect" or lowered == "overseer" or lowered == "com-god" then
            ShowLocalSystemMessage("[AI MoD] : Command failed. Architect, Overseer and Com-God cannot be spoofed.", true)
        elseif CanUseSpoof(LocalPlayer.Name) then
            SpoofedDisplayName = requested
            ShowLocalSystemMessage("[AI MoD] : Display name changed successfully ✓")
        else
            ShowLocalSystemMessage("[AI MoD] : Command failed. You do not have permission to use !spoof.", true)
        end
        MessageInput.Text = ""
        return
    elseif not isPrivate and typedText == "!spoof" then
        ShowLocalSystemMessage("[AI MoD] : Command failed. Usage: !spoof [NewName].", true)
        MessageInput.Text = ""
        return
    elseif not isPrivate and string.sub(typedText, 1, 9) == "!gplymsc " then
        if not CanUsePlayMusic(LocalPlayer.Name) then
            ShowLocalSystemMessage("[AI MoD] : Command failed. You do not have permission to play music.", true)
            MessageInput.Text = ""
            return
        end
        local id = typedText:sub(10):match("%d+")
        if not id then
            ShowLocalSystemMessage("[AI MoD] : Usage: !gplymsc [Roblox Music ID].", true)
            MessageInput.Text = ""
            return
        end
        -- Global legacy music command: update the global music session state.
        local payload = {
            Playing = true, CurrentSongId = id, CurrentSongName = GetMusicSongName(id),
            StartedAt = os.time(), UpdatedAt = os.time(), Revision = tostring(os.time()) .. "_g",
            HostUsername = LocalPlayer.Name, HostDisplayName = GetFormattedDisplayName(LocalPlayer.DisplayName, true),
            HostUserId = LocalPlayer.UserId, HostPfpId = CurrentPfpId, SessionId = "GLOBAL"
        }
        HttpRequest(MUSIC_SESSION_ROOT .. "/GLOBAL.json", "PATCH", payload)
        MessageInput.Text = ""
        return
    elseif not isPrivate and string.sub(typedText, 1, 9) == "!splymsc " then
        if not CanUsePlayMusic(LocalPlayer.Name) then
            ShowLocalSystemMessage("[AI MoD] : Command failed. You do not have permission to play music.", true)
            MessageInput.Text = ""
            return
        end
        local id = typedText:sub(10):match("%d+")
        if not id then
            ShowLocalSystemMessage("[AI MoD] : Usage: !splymsc [Roblox Music ID].", true)
            MessageInput.Text = ""
            return
        end
        local payload = {
            Playing = true, CurrentSongId = id, CurrentSongName = GetMusicSongName(id),
            StartedAt = os.time(), UpdatedAt = os.time(), Revision = tostring(os.time()) .. "_s",
            HostUsername = LocalPlayer.Name, HostDisplayName = GetFormattedDisplayName(LocalPlayer.DisplayName, true),
            HostUserId = LocalPlayer.UserId, HostPfpId = CurrentPfpId, SessionId = "SERVER_" .. SERVER_JOB_ID
        }
        HttpRequest(MUSIC_SESSION_ROOT .. "/SERVER_" .. SERVER_JOB_ID .. ".json", "PATCH", payload)
        MessageInput.Text = ""
        return
    elseif not isPrivate and typedText == "!stpmsc" then
        if not CanUsePlayMusic(LocalPlayer.Name) then
            ShowLocalSystemMessage("[AI MoD] : Command failed. You do not have permission to stop music.", true)
            MessageInput.Text = ""
            return
        end
        local id = ActiveTab == "GLOBAL" and "GLOBAL" or ("SERVER_" .. SERVER_JOB_ID)
        HttpRequest(MUSIC_SESSION_ROOT .. "/" .. id .. ".json", "PATCH", {Playing=false, UpdatedAt=os.time(), Revision=tostring(os.time()) .. "_stop"})
        MessageInput.Text = ""
        return
    elseif not isPrivate and string.sub(typedText, 1, 1) == "!" then
        ShowLocalSystemMessage("[AI MoD] : Unknown command. Command failed.", true)
        MessageInput.Text = ""
        return
    end

    -- Anti-spam applies to the actual message body, not the hidden PVT state.
    local spamText = privateBody
    local now = tick()
    if spamText == LastSentMessageText and (now - LastMessageSendTime) <= 30 then
        ConsecutiveSpamCount = ConsecutiveSpamCount + 1
    else
        ConsecutiveSpamCount = 1
    end

    if ConsecutiveSpamCount >= 3 then
        ShowAntiSpamMessage()
        MessageInput.Text = ""
        return
    end

    LastSentMessageText = spamText
    LastMessageSendTime = now

    local reply = ReplyContextMessage
    local clientMessageId = LocalPlayer.UserId .. "_" .. tostring(math.floor(os.clock() * 1000000)) .. "_" .. tostring(math.random(100000, 999999))

    local payload = {
        ClientMessageId = clientMessageId,
        Username = LocalPlayer.Name,
        UserId = LocalPlayer.UserId,
        DisplayName = GetFormattedDisplayName(LocalPlayer.DisplayName, true),
        Text = privateBody,
        Timestamp = os.time(),
        Role = GetAssignedOrCalculatedRole(LocalPlayer.Name),
        PfpId = CurrentPfpId,
        IsPrivate = isPrivate,
        TargetUsername = privateTargetUsername,
        TargetDisplayName = privateTargetDisplayName,
        ReplyToUsername = reply and reply.Username or nil,
        ReplyToDisplayName = reply and reply.DisplayName or nil,
        ReplyToText = reply and reply.Text or nil,
        ReplyToTimestamp = reply and reply.Timestamp or nil
    }

    -- Render immediately. The UI no longer waits for Firebase at all.
    local localCache = (ActiveTab == "GLOBAL") and GlobalCachedMessages or ServerCachedMessages
    local localUI = (ActiveTab == "GLOBAL") and GlobalUIElements or ServerUIElements
    local localKey = "local_" .. clientMessageId

    localCache[localKey] = payload
    local immediateCard = CreateMessageCard(payload, ActiveTab == "GLOBAL")
    immediateCard.Visible = true
    table.insert(localUI, immediateCard)

    MessageInput.Text = ""
    ReplyContextMessage = nil
    RefreshReplyUI()

    -- Firebase persistence is asynchronous and starts immediately after the
    -- local render. A deterministic client id lets polling recognize the
    -- same message and prevents a second copy from appearing.
    local targetUrl = (ActiveTab == "GLOBAL") and GLOBAL_MESSAGES_ENDPOINT or SERVER_MESSAGES_ENDPOINT
    task.spawn(function()
        local ok = pcall(function()
            HttpRequest(targetUrl, "POST", payload)
        end)
        if not ok then
            -- Keep the already-rendered local message; Firebase failure does
            -- not make the chat feel delayed or erase the user's message.
        end
    end)
end

