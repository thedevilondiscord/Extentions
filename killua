end

local function FetchRemoteRoles()
    local jsonRoster = HttpRequest(GITHUB_ROLE_LIST_URL, "GET")
    if not jsonRoster or type(jsonRoster) ~= "table" then
        RoleRosterLoaded = false
        RoleSwitchAuthorization = {}
        return
    end

    local fresh = {}
    local freshRoleSwitchAuthorization = {}
    for rankName, playerList in pairs(jsonRoster) do
        local canonicalRole = FindCanonicalRole(rankName)
        if canonicalRole and type(playerList) == "table" then
            local roleAuthorization = { Usernames = {}, UserIds = {} }
            if type(playerList.Usernames) == "table" then
                for _, username in ipairs(playerList.Usernames) do
                    local normalizedUsername = tostring(username or ""):match("^%s*(.-)%s*$")
                    if normalizedUsername ~= "" then
                        roleAuthorization.Usernames[string.lower(normalizedUsername)] = true
                    end
                end
            end
            if type(playerList.UserIds) == "table" then
                for _, userId in ipairs(playerList.UserIds) do
                    local normalizedUserId = tostring(userId or ""):match("^%s*(.-)%s*$")
                    if normalizedUserId ~= "" then
                        roleAuthorization.UserIds[normalizedUserId] = true
                    end
                end
            end
            freshRoleSwitchAuthorization[canonicalRole] = roleAuthorization

            local entries = playerList
            -- Also accept the convenient {Usernames = {...}, UserIds = {...}} format.
            if playerList.Usernames or playerList.UserIds then
                entries = {}
                if type(playerList.Usernames) == "table" then
                    for _, username in ipairs(playerList.Usernames) do
                        table.insert(entries, {Username = username})
                    end
                end
                if type(playerList.UserIds) == "table" then
                    for _, userId in ipairs(playerList.UserIds) do
                        table.insert(entries, {UserId = userId})
                    end
                end
            end
            for _, entry in ipairs(entries) do
                local targetUsername, targetUserId, targetEncodedId
                if type(entry) == "table" then
                    targetUsername = entry.Username or entry.Name
                    targetUserId = entry.UserId or entry.UserID or entry.Id
                    targetEncodedId = entry.EncodedId
                elseif type(entry) == "string" then
                    targetUsername = entry
                elseif type(entry) == "number" then
                    targetUserId = entry
                end

                targetUserId = targetUserId and tonumber(targetUserId) or nil
                targetEncodedId = targetEncodedId and tostring(targetEncodedId) or nil

                for _, player in ipairs(Players:GetPlayers()) do
                    local usernameMatch = targetUsername and RoleNameEquals(player.Name, targetUsername)
                    local userIdMatch = targetUserId and player.UserId == targetUserId
                    local encodedMatch = targetEncodedId and EncodePlayerId(player.UserId) == targetEncodedId
                    if usernameMatch or userIdMatch or encodedMatch then
                        fresh[player.Name] = fresh[player.Name] or {}
                        if not table.find(fresh[player.Name], canonicalRole) then
                            table.insert(fresh[player.Name], canonicalRole)
                        end
                    end
                end
            end
        end
    end

    AvailableUserRoles = fresh
    RoleSwitchAuthorization = freshRoleSwitchAuthorization
    RoleRosterLoaded = true
    for _, player in ipairs(Players:GetPlayers()) do
        local selected = AssignedPlayerRoles[player.Name]
        local selectedCanonical = selected and (FindCanonicalRole(selected) or selected) or nil
        local selectedStyle = selectedCanonical and RANK_STYLES[selectedCanonical] or nil
        local selectedTier1 = type(selectedStyle) == "table" and tonumber(selectedStyle.Tier) == 1

        -- Never replace a manually selected Tier 1 tag during a roster refresh.
        -- Restricted roles continue to be validated against the assigned role data.
        if not selected or (not selectedTier1 and not PlayerHasRole(player.Name, selectedCanonical)) then
            AssignedPlayerRoles[player.Name] = GetHighestRole(player.Name)
        else
            AssignedPlayerRoles[player.Name] = selectedCanonical
        end
    end
    Moderation.RefreshAllRoleAutocomplete()
end

