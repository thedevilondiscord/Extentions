local function resolveMessageRole(msg)
    local uid=tonumber(msg.UserId)
    local name=msg.Username
    local live=nil
    if uid then for _,p in ipairs(Players:GetPlayers()) do if tonumber(p.UserId)==uid then live=p;break end end end
    if not live and name then for _,p in ipairs(Players:GetPlayers()) do if lower(p.Name)==lower(name) then live=p;break end end end
    if live and roleRoster then
        for _,role in ipairs(ROLE_ORDER) do if recursiveMatch(roleRoster,role,live.UserId,live.Name) then return role end end
    end
    if uid and roleRoster then for _,role in ipairs(ROLE_ORDER) do if recursiveMatch(roleRoster,role,uid,name or "") then return role end end end
    return type(msg.Role)=="string" and msg.Role or ""
end

