local function processRemoteMessage(msg,scope)
    if type(msg)~="table" then return end
    if msg.Timestamp and tonumber(msg.Timestamp)<SCRIPT_START_TIME and not msg.IsJoinMessage then return end
    if msg.MuteAction and msg.TargetUserId then
        setMute(msg.Scope or scope,msg.TargetUserId,{expiresAt=tonumber(msg.ExpiresAt) or 0,imposedBy=msg.ImposedByDisplayName or msg.ImposedByUsername or "Moderator"})
        if tonumber(msg.TargetUserId)==tonumber(Players.LocalPlayer.UserId) then
            if (tonumber(msg.ExpiresAt) or 0)>os.time() then notify({ClientMessageId=msg.ClientMessageId,DisplayName="AI MoD",Text="You have been muted",PfpId=AI_MOD_PFP}) end
        end
        return
    end
    if msg.IsPrivate then
        local me=tonumber(Players.LocalPlayer.UserId);local sender=tonumber(msg.UserId);local target=tonumber(msg.TargetUserId)
        if sender~=me and target~=me then return end
    end
    if scope=="GLOBAL" then createMessageCard(msg) else createMessageCard(msg) end
    if msg.IsJoinMessage then playSound(JOIN_SOUND,.65) else notify(msg) end
end

local function pollEndpoint(endpoint,scope)
    local data=executorRequest(endpoint,"GET")
    if type(data)~="table" then return end
    for key,msg in pairs(data) do
        if type(msg)=="table" then
            if not msg.ClientMessageId then msg.ClientMessageId=tostring(key) end
            processRemoteMessage(msg,scope)
        end
    end
end

