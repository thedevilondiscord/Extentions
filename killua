function UpdateMusicSessionDisplay()
    local data = ActiveMusicSessionData
    if not data then
        MusicNowPlayingLabel.Text = "Not in a music session"
        MusicHostLabel.Text = "Host: —"
        MusicSessionIdLabel.Text = "Session ID: —"
        return
    end
    local song = data.Playing and (tostring(data.CurrentSongName or data.CurrentSongId or "Unknown") .. " [" .. tostring(data.CurrentSongId or "") .. "]") or "Nothing playing"
    MusicNowPlayingLabel.Text = "Now Playing: " .. song
    MusicHostLabel.Text = "Host: " .. tostring(data.HostDisplayName or "Unknown") .. "  (@" .. tostring(data.HostUsername or "unknown") .. ")"
    MusicSessionIdLabel.Text = "Session ID: " .. tostring(ActiveMusicSessionId or "—")
end

function RenderMusicSongList(category)
    MusicSelectedCategory = category
    for _, child in ipairs(MusicSongScroller:GetChildren()) do
        if child:IsA("TextButton") then child:Destroy() end
    end
    local songs = MusicRoster[category]
    if type(songs) ~= "table" then return end
    for _, song in ipairs(songs) do
        if type(song) == "table" then
            local b = Instance.new("TextButton")
            b.Size = UDim2.new(1, -8, 0, 24)
            b.BackgroundColor3 = Color3.fromRGB(25, 25, 38)
            b.BackgroundTransparency = 0.12
            b.BorderSizePixel = 0
            b.Font = Enum.Font.GothamMedium
            b.Text = "  " .. tostring(song.name or "Unnamed") .. "  •  " .. tostring(song.id or "")
            b.TextColor3 = Color3.fromRGB(235, 235, 240)
            b.TextSize = 9
            b.TextXAlignment = Enum.TextXAlignment.Left
            b.Parent = MusicSongScroller
            local c = Instance.new("UICorner")
            c.CornerRadius = UDim.new(0, 6)
            c.Parent = b
            b.MouseButton1Click:Connect(function()
                if not ActiveMusicSessionData or ActiveMusicSessionData.HostUsername ~= LocalPlayer.Name then
                    ShowLocalSystemMessage("[AI MoD] : Only the Music Session Host can play music.", true)
                    return
                end
                local id = tostring(song.id or "")
                if id == "" then return end
                local name = tostring(song.name or id)
                HostSetMusic(id, name)
            end)
        end
    end
end

function RenderMusicCategories()
    for _, child in ipairs(MusicCategoryFrame:GetChildren()) do
        if child:IsA("TextButton") then child:Destroy() end
    end
    if not MusicRosterLoaded then return end
    for _, category in ipairs(MusicRosterCategories) do
        local b = Instance.new("TextButton")
        b.Size = UDim2.new(0, 74, 0, 24)
        b.BackgroundColor3 = Color3.fromRGB(40, 40, 55)
        b.BackgroundTransparency = 0.2
        b.BorderSizePixel = 0
        b.Font = Enum.Font.GothamBold
        b.Text = tostring(category)
        b.TextColor3 = Color3.fromRGB(220, 220, 230)
        b.TextSize = 8
        b.Parent = MusicCategoryFrame
        local c = Instance.new("UICorner")
        c.CornerRadius = UDim.new(0, 6)
        c.Parent = b
        b.MouseButton1Click:Connect(function() RenderMusicSongList(category) end)
    end
    MusicCategoryFrame.CanvasSize = UDim2.new(0, MusicCategoryLayout.AbsoluteContentSize.X + 8, 0, 0)
    if MusicSelectedCategory and MusicRoster[MusicSelectedCategory] then
        RenderMusicSongList(MusicSelectedCategory)
    elseif MusicRosterCategories[1] then
        RenderMusicSongList(MusicRosterCategories[1])
    end
end

function UpdateMusicSessionMode()
    local inSession = ActiveMusicSessionId ~= nil
    MusicChoiceTitle.Visible = not inSession and not MusicCreatePanel.Visible and not MusicJoinPanel.Visible
    MusicCreateChoiceButton.Visible = not inSession and not MusicCreatePanel.Visible and not MusicJoinPanel.Visible
    MusicJoinChoiceButton.Visible = not inSession and not MusicCreatePanel.Visible and not MusicJoinPanel.Visible
    MusicChoiceHint.Visible = not inSession and not MusicCreatePanel.Visible and not MusicJoinPanel.Visible

    if not inSession then
        -- Returning from an ended/left session must always restore the actual
        -- choice screen. The previous version only hid the mute buttons,
        -- leaving the Create/Join panel visible.
        MusicCreatePanel.Visible = false
        MusicJoinPanel.Visible = false
        MusicMuteButton.Visible = false
        MusicJoinMuteButton.Visible = false
        MusicChoiceTitle.Visible = true
        MusicCreateChoiceButton.Visible = true
        MusicJoinChoiceButton.Visible = true
        MusicChoiceHint.Visible = true
    end

    if inSession then
        local host = ActiveMusicSessionData and ActiveMusicSessionData.HostUsername == LocalPlayer.Name
        MusicCreatePanel.Visible = host
        MusicJoinPanel.Visible = not host
        MusicMuteButton.Visible = true
        MusicJoinMuteButton.Visible = not host
        MusicJoinMuteButton.Text = MusicSessionMuted and "🔇 UNMUTE MY AUDIO" or "🔊 MUTE MY AUDIO"
        MusicChoiceTitle.Visible = false
        MusicCreateChoiceButton.Visible = false
        MusicJoinChoiceButton.Visible = false
        MusicChoiceHint.Visible = false
    end
end

