local function FindAllFirebaseMessageKeys(endpoint, clientMessageId)
    local keys = {}
    local data = HttpRequest(endpoint, "GET")
    if type(data) ~= "table" then return keys end
    for key, remote in pairs(data) do
        if type(remote) == "table" and tostring(remote.ClientMessageId or "") == tostring(clientMessageId or "") then
            table.insert(keys, tostring(key))
        end
    end
    return keys
end

local function FindFirebaseMessageKey(endpoint, clientMessageId)
    local data = HttpRequest(endpoint, "GET")
    if type(data) ~= "table" then return nil end
    for key, remote in pairs(data) do
        if type(remote) == "table" and tostring(remote.ClientMessageId or "") == tostring(clientMessageId or "") then
            return tostring(key)
        end
    end
    return nil
end

