local function StickerViewerAlreadySaved(id)
    id = tostring(id or "")
    if id == "" then
        return false
    end

    for _, saved in ipairs(PersistentCustomStickers) do
        if tostring(saved) == id then
            return true
        end
    end

    local normalized = GetStickerUrlFromId(id)
    for _, hardcoded in ipairs(baseStickers) do
        if tostring(hardcoded) == normalized then
            return true
        end
    end

    return false
end

