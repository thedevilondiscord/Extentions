local function sendChat(raw)
    raw=trim(raw)
    if raw=="" then return end
    local muted=isMuted(activeTab)
    if muted then renderLocal(createLocalSystem("🔇 You can't chat for the next "..formatTime(muted.expiresAt-os.time()).." due to a mute enforced by "..tostring(muted.imposedBy or "Moderator").."."));return end
    if raw==lastSentText and os.time()-lastMessageSendTime<=30 then consecutiveSpam=consecutiveSpam+1 else consecutiveSpam=0 end
    lastSentText=raw;lastMessageSendTime=os.time()
    if consecutiveSpam>=3 then renderLocal(createLocalSystem("Deep breath in, deep breath out. Now, please stop spamming 😣"));consecutiveSpam=0;return end
    local msg={ClientMessageId=newId(),Username=Players.LocalPlayer.Name,UserId=Players.LocalPlayer.UserId,DisplayName=Players.LocalPlayer.DisplayName,Text=raw,Timestamp=os.time(),Role=highestRole or "",PfpId=currentPfp,IsPrivate=false}
    if privateTarget then
        msg.IsPrivate=true;msg.TargetUsername=privateTarget.Username;msg.TargetDisplayName=privateTarget.DisplayName
        local target=findPlayer(privateTarget.Username or privateTarget.DisplayName);if target then msg.TargetUserId=target.UserId end
    end
    if replyTarget then msg.ReplyToUsername=replyTarget.Username;msg.ReplyToDisplayName=replyTarget.DisplayName;msg.ReplyToText=replyTarget.Text;msg.ReplyToTimestamp=replyTarget.Timestamp;replyTarget=nil end
    renderLocal(msg);persistMessage(msg,activeTab)
