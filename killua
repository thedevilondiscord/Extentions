local function StopLocalMusicSessionAudio()
    -- Hard local stop: clear the Sound completely so an old/pending asset
    -- cannot continue after Leave Session or End Session.
    pcall(function()
        MusicSessionSound:Stop()
        MusicSessionSound.Playing = false
        MusicSessionSound.SoundId = ""
        MusicSessionSound.TimePosition = 0
        MusicSessionSound.Volume = 0
    end)
end

local function ApplyMusicSessionAudio(session)
    if type(session) ~= "table" or not session.Playing or not session.CurrentSongId then
        StopLocalMusicSessionAudio()
        return
    end

    local songId = tostring(session.CurrentSongId)
    local desiredSoundId = "rbxassetid://" .. songId
    local startedAt = tonumber(session.StartedAt or session.UpdatedAt or os.time()) or os.time()
    local elapsed = math.max(0, os.time() - startedAt)

    -- Mute is strictly local. Always re-apply the local volume when Firebase
    -- refreshes the shared song state so a muted client stays muted.
    MusicSessionSound.Volume = MusicSessionMuted and 0 or 0.5

    if MusicSessionSound.SoundId ~= desiredSoundId then
        MusicSessionSound.SoundId = desiredSoundId
        MusicSessionSound.TimePosition = elapsed
        pcall(function() MusicSessionSound:Play() end)
    elseif not MusicSessionSound.IsPlaying then
        MusicSessionSound.TimePosition = elapsed
        pcall(function() MusicSessionSound:Play() end)
    end
end

