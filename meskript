local function safeCall(fn,...)
    if type(fn) ~= "function" then return false,nil end
    local ok,a,b,c,d = pcall(fn,...)
    if ok then return true,a,b,c,d end
    return false,nil
end

local function getGlobal(name)
    local ok,v = pcall(function() return getfenv and getfenv()[name] end)
    if ok and v ~= nil then return v end
    local ok2,v2 = pcall(function() return _G[name] end)
    if ok2 then return v2 end
end

local function jsonEncode(v)
    local ok,res = pcall(function() return HttpService:JSONEncode(v) end)
    return ok and res or nil
end
local function jsonDecode(v)
    if type(v) ~= "string" or v == "" or v == "null" then return nil end
    local ok,res = pcall(function() return HttpService:JSONDecode(v) end)
    return ok and res or nil
end

local function executorRequest(url,method,data)
    local body = data and jsonEncode(data) or nil
    local headers = { ["Content-Type"]="application/json" }
    local candidates = {}
    local syn = getGlobal("syn")
    local http = getGlobal("http")
    local fluxus = getGlobal("fluxus")
    if type(syn)=="table" and type(syn.request)=="function" then table.insert(candidates,syn.request) end
    if type(http)=="table" and type(http.request)=="function" then table.insert(candidates,http.request) end
    local httpRequest = getGlobal("http_request")
    if type(httpRequest)=="function" then table.insert(candidates,httpRequest) end
    local request = getGlobal("request")
    if type(request)=="function" then table.insert(candidates,request) end
    if type(fluxus)=="table" and type(fluxus.request)=="function" then table.insert(candidates,fluxus.request) end

    for _,fn in ipairs(candidates) do
        local ok,res = pcall(fn,{Url=url,Method=method or "GET",Headers=headers,Body=body})
        if ok and type(res)=="table" then
            local code = tonumber(res.StatusCode or res.Status or 200) or 200
            if code >= 200 and code < 300 then return jsonDecode(res.Body or res.body or "") end
        end
    end

    -- Fallback to Roblox HttpService if executor exposes HTTP to the script.
    local ok,res = pcall(function()
        if method == "POST" then
            local raw = HttpService:PostAsync(url,body or "{}",Enum.HttpContentType.ApplicationJson,false)
            return jsonDecode(raw)
        else
            return jsonDecode(HttpService:GetAsync(url,false))
        end
    end)
    if ok then return res end
    return nil
end

local function executorWrite(path,data)
    local isfile,writefile = getGlobal("isfile"),getGlobal("writefile")
    if type(writefile) ~= "function" then return false end
    if type(isfile)=="function" then
        local ok,exists=pcall(isfile,path)
        if ok and exists then
            -- overwrite intentionally
        end
    end
    return pcall(writefile,path,tostring(data))
end
local function executorRead(path)
    local isfile,readfile = getGlobal("isfile"),getGlobal("readfile")
    if type(readfile) ~= "function" then return nil end
    if type(isfile)=="function" then
        local ok,exists=pcall(isfile,path)
        if not ok or not exists then return nil end
    end
    local ok,res=pcall(readfile,path)
    return ok and res or nil
end
