local function roleStyle(role)
    if ROLE_STYLES[role] then return ROLE_STYLES[role] end
    local c=TIER3_COLORS[role] or Color3.fromRGB(220,60,60)
    return {start=c,finish=Color3.fromRGB(5,5,5)}
end
local function animateRole(label,role)
    local st=roleStyle(role)
    if st.mode=="RAINBOW_WHITE" then
        task.spawn(function()
            local phase=0
            while label.Parent do
                phase=(phase+RunService.RenderStepped:Wait()*st.speed)%1
                local hue=phase
                local c=Color3.fromHSV(hue,1,1):Lerp(Color3.new(1,1,1),.15)
                label.TextColor3=c
            end
        end)
    else
        task.spawn(function()
            local t=0
            while label.Parent do
                t=(t+RunService.RenderStepped:Wait()*.9)%2
                local a=t<=1 and t or 2-t
                label.TextColor3=st.start:Lerp(st.finish,a)
            end
        end)
    end
end

local function displayNameFor(msg)
