    for _, list in ipairs({GlobalUIElements, ServerUIElements}) do
        for i = #list, 1, -1 do
            local card = list[i]
            if card and string.lower(tostring(card:GetAttribute("MessageUsername") or "")) == wanted then
                if card.Parent then
                    card:Destroy()
                end
                table.remove(list, i)
            elseif card and not card.Parent then
                table.remove(list, i)
            end
        end
    end
end

local function BlockMessageUser(username)
    username = tostring(username or "")
    if username == "" or string.lower(username) == string.lower(tostring(LocalPlayer.Name or "")) then
        return false
    end
    BlockedMessageUsers[string.lower(username)] = true
    RemoveBlockedUserFromLocalChat(username)
    return true
end

