-- Rebuild the sticker picker from the single persistent list.
-- This is shared by both save paths so the picker never needs a restart.
RebuildStickerGrid = function()
    for _, child in ipairs(StickerScroller:GetChildren()) do
        if child:IsA("GuiButton") then
            child:Destroy()
        end
    end

    -- First cell is ALWAYS the + button.
    BuildStickerButton(nil, 1, true)

    -- Newly saved stickers are inserted immediately after + and before every
    -- built-in sticker. Each custom ID remains persistent across executions.
    for index, stickerId in ipairs(PersistentCustomStickers) do
        BuildStickerButton(GetStickerUrlFromId(stickerId), index + 1, false)
    end

    for index, stickerUrl in ipairs(baseStickers) do
        BuildStickerButton(stickerUrl, #PersistentCustomStickers + index + 1, false)
    end
end

RebuildStickerGrid()

StickerSaveButton.Activated:Connect(function()
    local stickerId = NormalizeStickerId(StickerIdInput.Text)
    if not stickerId then
        StickerIdInput.Text = ""
        StickerIdInput.PlaceholderText = "Enter a valid numeric ID"
        return
    end

    for i = #PersistentCustomStickers, 1, -1 do
        if PersistentCustomStickers[i] == stickerId then
            table.remove(PersistentCustomStickers, i)
        end
    end
    table.insert(PersistentCustomStickers, 1, stickerId)
    SavePersistentCustomStickers()

    -- Rebuild the grid so the newly saved sticker is immediately first.
    if RebuildStickerGrid then
        RebuildStickerGrid()
    end

    StickerAddPopup.Visible = false
    StickerIdInput.Text = ""
end)

